package question1;
// 클래스 : 설계도 속성(필드) + 동작(메서드)

// 프로그램 실행 클래스
public class Main {
    public static void main(String[] args) {
        // Character 객체 생성
        Character c = new Character();

        // 속성 값 할당
        c.name = "아서스";
        c.hp = 120;

        // 메서드 호출 → 캐릭터 정보 출력
        c.displayInfo();
    }
}
