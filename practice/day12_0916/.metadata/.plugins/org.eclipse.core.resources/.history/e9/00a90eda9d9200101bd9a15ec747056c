package co.kr.bank;

public class CheckingAccount extends Account {
	public CheckingAccount(String owner, int balance) {
		super(owner, balance);
	}

	@Override
	public void doTransaction(int amout) {
		if (balance >= amount) {
			balance -= amount; //출금
			System.out.println(owner + "의 당좌 계좌: " + amount + "원 출금 완료,"
					+ " 현재 잔액 = " + balance + "원");
		}else {
			System.out.println(owner + "의 당좌 계좌: 잔액 부족!");
		}
		super.doTransaction(amout);
	}
	
	
}
