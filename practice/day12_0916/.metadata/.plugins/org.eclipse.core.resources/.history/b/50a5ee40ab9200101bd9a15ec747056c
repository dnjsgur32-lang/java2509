package co.kr.library;

public abstract class LibraryItem implements Borrowable {
	String title;
	
	public LibraryItem(String title) {
		this.title = title;
	}

	public void displayInfo() {
		System.out.println("자료명: " + title);
		System.out.println("====================");

	}

	@Override
	public abstract void borrow();

	

}
