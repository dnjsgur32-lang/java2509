package com.ljh.trycatch;

public class TryMain {

    public TryMain() {
        // ArrrayIndexOutBoundsException
        try {
            int[] myNums = { 1, 2, 3 };
            System.out.println(myNums[10]); // ArrayIndexOutOfBoundsException 발생
        } catch (Exception e) {
            // 자바가 던져주는 오류 메세지
            e.printStackTrace();
            System.out.println("너의 인덱스는 틀렸어. 너는 배열이 3개 뿐이야.");
        } finally {
            System.out.println("try~catch 구문을 나가기전에 " + "해야 할 일을 여기에서 작성한다. 끝~");
            System.out.println("===========================================");
        }

        // throw 키워드 : Exception 개발자 정의 오류 (중단 방지용으로 감쌈)
        try {
            checkAge(15);
        } catch (ArithmeticException e) {
            System.out.println(e.getMessage());
        }

        // 다중 try~catch 데모 실행
        runMultiTryCatch();
    }

    // 다중 try~catch 구문 (클래스 본문 → 메서드 내부로 이동)
    private void runMultiTryCatch() {
        try {
            int[] nums = { 1, 2, 3 };
            System.out.println(nums[10]); // 먼저 여기서 예외 발생
            int result = 10 / 0;          // 위에서 예외가 발생하면 실행되지 않음
            System.out.println(result);
        } catch (ArrayIndexOutOfBoundsException e) {
            System.out.println("ArrayIndexOutBoundsException: 배열의 인덱스");
        } catch (ArithmeticException e) {
            System.out.println("ArithmeticException : 연산오류");
        } catch (Exception e) {
            System.out.println("Exception: 모든 오류");
        }
    }

    private void checkAge(int age) {
        if (age < 18) {
            throw new ArithmeticException("18세 미만은 입장이 제한됩니다.");
        } else {
            System.out.println("18세 이상이군요. 입장을 허용합니다.");
        }
    }
}
