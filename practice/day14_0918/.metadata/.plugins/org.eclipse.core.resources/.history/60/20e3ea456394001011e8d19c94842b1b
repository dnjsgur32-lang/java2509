package co.kr.ljh;

public class Student {
	private final String name;
	private final java.util.Map<String, Integer> scores = new java.util.LinkedHashMap<>();

	public Student(String name) {
		if (name == null || name.isBlank()) {
			throw new IllegalArgumentException("name 필수");
		}
		this.name = name;
	}

	public Student add(String sub, int score) {
		if (sub == null || sub.isBlank()) {
			throw new IllegalArgumentException("subject 필수");
		}
		if (score < 0 || score > 100) {
			throw new IllegalArgumentException("score 0~100");
		}
		scores.put(sub, score);
		return this;
	}

	public double avg() {
		if(scores.isEmpty())return 0.0;
		int sum = 0;
		for (int v : scores.values()) sum += v;
		return sum / (double) scores.size();
	}

	public String name() {
		
	}
}







