package com.ljh.trycatch;

public class TryMain {
	public TryMain() {

//		ArrrayIndexOutBoundsException
		try {
			int[] myNums = { 1, 2, 3 };
			System.out.println(myNums[10]);
		} catch (Exception e) {
//			자바가 던져주는 오류 메세지
			e.printStackTrace();
			System.out.println("너의 인덱스는 틀렸어. 너는 배열이 3개 뿐이야.");
		} finally {
			System.out.println("try~catch 구문을 나가기전에 " 
							+ "해야 할 일을 여기에서 작성한다. 끝~");
		}
		
//		throw
		checkAge(15);
	}

	private void checkAge(int i) {

	}
}
